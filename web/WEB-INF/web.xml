<?xml version="1.0" encoding="UTF-8"?>
<web-app version="2.5" xmlns="http://java.sun.com/xml/ns/javaee" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-app_2_5.xsd">
    
    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>
    
    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>controllers.LoginServlet</servlet-class>

        <init-param>
            <param-name>DB_USER</param-name>
            <param-value>app</param-value>
        </init-param>
        
        <init-param>
            <param-name>DB_PASSWORD</param-name>
            <param-value>app</param-value>
        </init-param>
        
        <init-param>
            <param-name>DB_URL</param-name>
            <param-value>jdbc:derby://localhost:1527/UserDB</param-value>
        </init-param>

        <init-param>
            <param-name>CipherAlgorithm</param-name>
            <param-value>AES/ECB/PKCS5PADDING</param-value>
        </init-param>

        <init-param>
            <param-name>encryptionKey</param-name>
            <param-value>icscompscitwocsd</param-value>
        </init-param>
    
    </servlet>
    
    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>controllers.LogoutServlet</servlet-class>
    </servlet>
    
    <servlet>
        <servlet-name>ReportServlet</servlet-name>
        <servlet-class>controllers.ReportServlet</servlet-class>
        
                <init-param>
            <param-name>DB_USER</param-name>
            <param-value>app</param-value>
        </init-param>
        
        <init-param>
            <param-name>DB_PASSWORD</param-name>
            <param-value>app</param-value>
        </init-param>
        
        <init-param>
            <param-name>DB_URL</param-name>
            <param-value>jdbc:derby://localhost:1527/UserDB</param-value>
        </init-param>

        <init-param>
            <param-name>CipherAlgorithm</param-name>
            <param-value>AES/ECB/PKCS5PADDING</param-value>
        </init-param>

        <init-param>
            <param-name>encryptionKey</param-name>
            <param-value>icscompscitwocsd</param-value>
        </init-param>
    </servlet>
    
    <servlet-mapping>
        <servlet-name>ReportServlet</servlet-name>
        <url-pattern>/ReportServlet</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>
    
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>
    
    <context-param>
        <param-name>captchaLength</param-name>
        <param-value>5</param-value> 
    </context-param>

    <servlet>
        <servlet-name>CaptchaServlet</servlet-name>
        <servlet-class>controllers.CaptchaServlet</servlet-class>
    </servlet>
    
    <servlet-mapping>
        <servlet-name>CaptchaServlet</servlet-name>
        <url-pattern>/captcha</url-pattern>
    </servlet-mapping>

    <listener>
        <listener-class>controllers.DateTimeServlet</listener-class>
    </listener>
    
    <context-param>
        <param-name>Header</param-name>
        <param-value>/header.jsp</param-value>
    </context-param>
    
    <context-param>
        <param-name>Footer</param-name>
        <param-value>/footer.jsp</param-value>
    </context-param>
    
    <session-config>
        <session-timeout>5</session-timeout>
    </session-config>
    
    <error-page>
        <error-code>404</error-code>
        <location>/error_4.jsp</location>
    </error-page>
    
    <error-page>
        <exception-type>javax.security.sasl.AuthenticationException</exception-type>
        <location>/error_2.jsp</location>
    </error-page>
    
    <error-page>
         <exception-type>java.lang.NullValueException</exception-type>
        <location>/noLoginCredentials.jsp</location>
    </error-page>
    
</web-app>
